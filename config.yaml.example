# Lifehug — Local config (gitignored)
#
# SECRETS and machine-local overrides ONLY. This file is gitignored so API keys
# and tokens are never committed. Your identity and preferences (name, full_name,
# timezone, question_time, channel) live in profile.yaml, which IS committed and
# travels with your repo. Copy this to config.yaml only if you need something
# below; values here override profile.yaml on this machine.

# Telegram delivery targets. Use one of these when running system/daily_question.sh.
# telegram_chat_id works for DMs or groups. group_chat_id is accepted as an alias
# for older setup instructions.
# telegram_chat_id: ""
# group_chat_id: ""

# --- AI models ---
# Pass-transition question generation:
followup_model: "anthropic/claude-opus-4-6"
# Warm 2–4 sentence answer acknowledgment (shared provider; default Sonnet):
# answer_ack_model: "claude-sonnet-5"
# Research neighborhood expansion (self-knowledge, gaps, topics):
# research_model: "claude-opus-4-20250514"
# Story/source classification:
# classify_model: "claude-sonnet-4-20250514"
# Wiki page synthesis (system/lifehug.py compile); falls back to deterministic
# excerpts when the selected shared provider is unavailable:
# wiki_model: "claude-opus-4-20250514"
# Anthropic API key, when that provider is selected (or set ANTHROPIC_API_KEY):
# anthropic_api_key: ""

# --- On-machine OpenAI-compatible model (v120) ---
# Ollama, LM Studio, llama.cpp, or another OpenAI-compatible server can run
# every model-backed Loop surface without sending source material off-device.
# All three values are required. `ai_provider: local` is fail-closed: if the
# endpoint is invalid or offline, Lifehug uses agent-task/keyless mode and does
# NOT fall through to OpenClaw, Kimi, or Anthropic.
# ai_provider: "local"
# local_ai_base_url: "http://127.0.0.1:11434/v1"
# local_ai_model: "qwen3:8b"
# local_ai_timeout_seconds: 120
# Optional, only if the local server requires a bearer token:
# local_ai_api_key: ""
# Non-loopback hosts are rejected by default. This explicit escape hatch means
# accepting that private source material will leave this machine:
# local_ai_allow_non_loopback: false
# Local requests ignore HTTP(S)_PROXY and refuse redirects, so a validated
# loopback destination cannot be changed underneath the privacy boundary.
# Check the selected provider/model and make a non-mutating GET /models probe:
#   python3 system/lifehug.py ai-status

# --- Kimi models (v113) ---
# Any model named kimi*/moonshot*/k3* routes to the Kimi OpenAI-compatible
# endpoint instead of Anthropic. Key from the Kimi Code Console (or set
# KIMI_API_KEY in the environment):
# kimi_api_key: ""
# Default endpoint is the Kimi Code API; override for the Kimi Platform:
# kimi_base_url: "https://api.kimi.com/coding/v1"
# Run connector dossiers on Kimi without moving the weekly classifier
# (dossier_model wins for dossiers; classify_model stays Anthropic):
# dossier_model: "kimi-for-coding"

# --- Roadmap / Focuses ---
# Your roadmap (state/roadmap.json) is DERIVED automatically from your question
# bank and answers — you don't edit it here. Manage Focuses with the CLI:
#   python3 system/lifehug.py roadmap                 # see Focuses + saturation
#   python3 system/lifehug.py focus-add "Etherfuse" --type project --tier extreme \
#       --objective "founding-story book" --deliverable book --category F --category G
#   python3 system/lifehug.py focus-finish etherfuse  # push a deliverable to done (lifts its cap)
#   python3 system/lifehug.py progress                # are we graduating toward deliverables?
#
# Tiers set how deep a Focus goes before it's "well-known": basic ~8 answers
# (blog), standard ~20 (essay/chapter/a person), extreme ~50+ (book / life's work).
